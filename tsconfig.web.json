{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist"
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.vue",
    "src/renderer/changelog.json",
    "src/renderer/package.json"
  ],
  "exclude": [
    "src/renderer/scripts",
    "src/renderer/vite.config.ts",
    "src/renderer/vite.lib.config.ts",
    "src/renderer/vite.celldl.config.ts"
  ]
}
