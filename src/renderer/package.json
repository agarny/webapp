{
  "author": {
    "name": "Alan Garny",
    "email": "a.garny@auckland.ac.nz"
  },
  "bugs": {
    "url": "https://github.com/opencor/webapp/issues"
  },
  "description": "A Web-based modelling environment for organising, editing, simulating, and analysing CellML files.",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "homepage": "https://opencor.ws/",
  "keywords": [
    "vue",
    "component",
    "opencor",
    "cellml",
    "sed-ml",
    "omex",
    "combine"
  ],
  "license": "Apache-2.0",
  "module": "dist/opencor.es.js",
  "name": "@opencor/opencor",
  "productName": "OpenCOR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencor/webapp.git"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "engines": {
    "bun": ">=1.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/opencor.es.js"
    },
    "./style.css": "./dist/opencor.css"
  },
  "version": "1.20261113.0",
  "libopencorVersion": "1.20261111.0",
  "scripts": {
    "build": "vite build && bun scripts/generate.version.ts",
    "build:lib": "vite build --config vite.lib.config.ts && bun --bun scripts/type.check.ts --project tsconfig.lib.types.json",
    "build:stats": "STATS=true vite build && bun scripts/generate.version.ts",
    "clean": "bun scripts/clean.ts",
    "dependencies:update": "bun scripts/dependencies.update.ts",
    "dev": "vite dev",
    "format": "bunx --bun biome format --fix --max-diagnostics=none",
    "format:check": "bunx --bun biome format --max-diagnostics=none",
    "lint": "bunx --bun biome lint --fix --error-on-warnings --max-diagnostics=none && bunx stylelint '**/*.css' --fix",
    "start": "bun run build && vite preview",
    "typecheck": "bun --bun scripts/type.check.ts --noEmit",
    "version:new": "bun scripts/version.new.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@celldl/editor": "^0.20261109.0",
    "@celldl/rdf": "^1.20260822.0",
    "@opencor/libopencor-types": "^1.20261111.0",
    "@physiomelinks/bg2cellml": "^0.6.2",
    "@primeuix/themes": "2.0.3",
    "@primevue/auto-import-resolver": "4.5.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "autoprefixer": "^10.6.2",
    "libcellml.js": "^0.7.2",
    "oxigraph": "^0.5.13",
    "postcss": "^8.5.32",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "rollup-plugin-visualizer": "^7.1.3",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.1",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "uplot": "1.6.32",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14",
    "xxhash-wasm": "^1.1.0"
  }
}
